<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadran « Christen Dijoux » (Watch Face Format v2), au thème du portfolio :
  anneau de progression des pas sur le bord, nom en haut, température et indice UV,
  heure, date, pas du jour et ville actuelle en bas (fournie par l'app).
  Repère : cercle de 450 px centré en (225, 225) ; angles en degrés depuis midi, sens horaire.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF050505">

        <!-- Anneau des pas : piste, puis progression vers l'objectif du jour -->
        <Group name="steps_ring" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="424" height="424" startAngle="0" endAngle="360">
                    <Stroke color="#FF262624" thickness="8" />
                </Arc>
            </PartDraw>
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="424" height="424" startAngle="0" endAngle="0">
                    <Transform target="endAngle" value="clamp([STEP_PERCENT], 0, 100) * 3.6" />
                    <Stroke color="#FFF2F2EE" thickness="8" cap="ROUND" />
                </Arc>
            </PartDraw>
        </Group>

        <!-- Repères des heures, à l'intérieur de l'anneau -->
        <Group name="hour_marks" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="450" height="450">
                <Line startX="225.0" startY="28.0" endX="225.0" endY="38.0"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="323.5" startY="54.4" endX="318.5" endY="63.1"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="395.6" startY="126.5" endX="386.9" endY="131.5"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="422.0" startY="225.0" endX="412.0" endY="225.0"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="395.6" startY="323.5" endX="386.9" endY="318.5"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="323.5" startY="395.6" endX="318.5" endY="386.9"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="225.0" startY="422.0" endX="225.0" endY="412.0"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="126.5" startY="395.6" endX="131.5" endY="386.9"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="54.4" startY="323.5" endX="63.1" endY="318.5"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="28.0" startY="225.0" endX="38.0" endY="225.0"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="54.4" startY="126.5" endX="63.1" endY="131.5"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
                <Line startX="126.5" startY="54.4" endX="131.5" endY="63.1"><Stroke color="#59F2F2EE" thickness="2" cap="ROUND" /></Line>
            </PartDraw>
        </Group>

        <!-- Nom le long du bord, en haut -->
        <PartText x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TextCircular centerX="225" centerY="225" width="330" height="330" startAngle="-55" endAngle="55" direction="CLOCKWISE" align="CENTER">
                <Font family="geist_mono_regular" size="19" color="#A8F2F2EE">CHRISTEN DIJOUX</Font>
            </TextCircular>
        </PartText>

        <!-- Température et indice UV, seulement si la montre a des données météo -->
        <Condition>
            <Expressions>
                <Expression name="weather"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
            </Expressions>
            <Compare expression="weather">
                <PartText x="75" y="98" width="300" height="36">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="geist_mono_regular" size="22" color="#CCF2F2EE">
                            <Template>%s° · UV %s<Parameter expression="round([WEATHER.TEMPERATURE])" /><Parameter expression="round([WEATHER.HOURS.0.UV_INDEX])" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
        </Condition>

        <!-- Heure -->
        <DigitalClock x="0" y="128" width="450" height="150">
            <Variant mode="AMBIENT" target="alpha" value="190" />
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="150">
                <Font family="big_shoulders_display_light" size="150" color="#FFF2F2EE" />
            </TimeText>
        </DigitalClock>

        <!-- Date, en majuscules dans la langue de la montre -->
        <PartText x="25" y="276" width="400" height="34">
            <Variant mode="AMBIENT" target="alpha" value="128" />
            <Text align="CENTER">
                <Font family="geist_mono_regular" size="22" color="#A8F2F2EE">
                    <Upper>
                        <Template>%s %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
                    </Upper>
                </Font>
            </Text>
        </PartText>

        <!-- Pas du jour et objectif -->
        <Group name="steps" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartImage x="141" y="318" width="26" height="26">
                <Image resource="ic_steps" />
            </PartImage>
            <PartText x="175" y="312" width="86" height="36">
                <Text align="START">
                    <Font family="geist_mono_regular" size="24" color="#FFF2F2EE">
                        <Template>%s<Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText x="257" y="316" width="90" height="30">
                <Text align="START">
                    <Font family="geist_mono_regular" size="17" color="#66F2F2EE">
                        <Template>/%s<Parameter expression="[STEP_GOAL]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Ville actuelle le long du bord, en bas : complication fixe fournie par l'app (localisation) -->
        <ComplicationSlot slotId="0" x="0" y="0" width="450" height="450" supportedTypes="SHORT_TEXT" isCustomizable="FALSE">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" primaryProvider="com.christendijoux.watch/com.christendijoux.watch.complication.CityComplicationService" primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="125" y="372" width="200" height="50" />
            <Variant mode="AMBIENT" target="alpha" value="128" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="330" height="330" startAngle="235" endAngle="125" direction="COUNTER_CLOCKWISE" align="CENTER">
                        <Font family="geist_mono_regular" size="19" color="#A8F2F2EE">
                            <Upper>
                                <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                            </Upper>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
        </ComplicationSlot>

    </Scene>
</WatchFace>
